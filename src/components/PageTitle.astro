---
// Starlight の PageTitle を上書きして、タイトルの下に確認状態とタグを表示する
import Default from '@astrojs/starlight/components/PageTitle.astro';
import TagList from './TagList.astro';
import { getTagIndex } from '../lib/tags';
import { STATUS_INFO, hasStatus } from '../lib/status';

const { entry } = Astro.locals.starlightRoute;
const { tagsOf } = await getTagIndex();
const tags = tagsOf.get(entry.id) ?? [];
const status = hasStatus(entry) ? STATUS_INFO[entry.data.status] : undefined;
---

<Default />
{
	status && (
		<p class="page-status" data-status={entry.data.status}>
			{status.icon} {status.label}
		</p>
	)
}
<TagList tags={tags} />

<style>
	.page-status {
		margin: 0.5rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
</style>
