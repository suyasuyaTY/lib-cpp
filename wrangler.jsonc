// Cloudflare Workers の設定（静的サイトとして dist/ を配信する）
// main ブランチ → algo.suyasuyaty.com（Custom Domain はダッシュボードで設定）
// それ以外のブランチ → <ブランチ名>-lib-cpp.<アカウント>.workers.dev のプレビュー
{
	"name": "lib-cpp",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	},
	"preview_urls": true
}
